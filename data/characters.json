  "purpose": "동물·창작 괴물·신화 모티프 직원 수집 콘텐츠의 v0.4 후보 데이터",
  "numeric_values_status": "능력치·특성 효과·희소성 수치는 모두 개발용 창작 값. 현실의 개인·동물·국가·집단 역량에 대한 추정이 아니다.",
  "rules": {
    "base_stat_budget": 300,
    "stat_range": [
      0,
      100
    ],
    "starter_level": 1,
    "stat_scale_meaning": "프로젝트 내부의 상대적 기본 적성. 곧바로 성공 확률·생산량·할인율로 해석하지 않는다.",
    "attribute_rule": "속성은 판타지 세계의 연출과 팀 편성 태그. 실제 화학 원소·에너지 분류가 아니며 화물의 질량·부피·온도·운송시간·회계를 무효화하지 않는다.",
    "rarity_rule": "희소성은 만남·의뢰 조건의 차이. 모든 초기 능력치 합은 300, 레벨은 1, 희소성 성능 배율은 1.0. 희귀 캐릭터가 항상 상위 호환이 되지 않게 한다.",
    "assignment_rule": "소속 조직과 편성안은 예약이 아니다. 업무 확정 시 직원별 시간 구간을 단일 예약하고 시작 구성을 고정한다.",
    "country_rule": "국가 태그는 출신 고정 능력이나 혈통 보너스로 만들지 않는다. 지역 지식·문화 이해·NPC 친밀·거래 신뢰는 별도 상태다.",
    "science_boundary": "판타지 특성은 업무 평가에만 제한적으로 영향을 주는 설계 후보다. 폭우·태풍·보관 온도·에너지·관세·기업 가치의 실제 모형과 분리한다.",
    "implementation_rule": "P0에서 기존 직원 ID와 정상 거래 예제를 보존한다. 후보 효과와 덱 시너지는 공통 계산 순서·상한·중복 예약 규칙을 정한 뒤 구현한다."
  },
