+const MARK_GROUP: Record<HubStatus | 'gate' | 'ship', string> = {
+  active: '이번 시나리오 거점', planned: '1장에서 열릴 거점', preview: '세계 확장(2장) 미리 보기', gate: '해협·운하', ship: '운항 중인 배',
