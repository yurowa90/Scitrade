+    marks.push({ key: `gate:${g.id}`, group: MARK_GROUP.gate, nameKo: g.nameKo, lines: [g.connectsKo, g.eventHookKo, '세계 확장(2장)에서 항로 선택·사건과 연결 예정'] });
+  }
