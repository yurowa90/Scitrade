+/** 한 열(style.css의 max-width: 1000px)이면 화면 코드 순서를 한 열의 보이는 순서로 그린다. Tab·화면 읽기 순서가 보이는 순서와 같아진다. */
+const ONE_COLUMN = typeof window !== 'undefined' && typeof window.matchMedia === 'function' ? window.matchMedia('(max-width: 1000px)') : null;
+function oneColumn(): boolean { return !!ONE_COLUMN?.matches; }
+// 회전·창 크기로 한 열 여부가 바뀌면 순서를 다시 그린다. 초점은 화면 밖이어도 같은 조작에 남긴다(지금 빌드에서 창 크기가 바뀔 때와 같음).
+ONE_COLUMN?.addEventListener?.('change', () => {
+  const was = document.activeElement as HTMLElement | null;
+  const data = was && (was.id || was.dataset?.action) ? { id: was.id, tag: was.tagName, set: { ...was.dataset } } : null;
+  render(true);
+  if (!data) return;
+  const again = (data.id && document.getElementById(data.id)) || Array.from(app.querySelectorAll<HTMLElement>('[data-action]'))
+    .find((el) => el.tagName === data.tag && Object.entries(data.set).every(([key, value]) => el.dataset[key] === value));
+  again?.focus({ preventScroll: true });
+});
