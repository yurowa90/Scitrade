+/** 펼친 칸의 실행 단추(훈련·고용)를 보이는 띠 안으로 최소 거리만 가져온다. 칸 제목(일반 훈련·면담)은 막대(창 위 끝) 아래에 남긴다. */
+function revealBelow(target: HTMLElement | null, head: HTMLElement | null) {
+  if (!target) return;
+  const pane = paneEl();
+  const inPane = !!pane && pane.contains(target);
+  let top = app.querySelector<HTMLElement>('.statusbar')?.getBoundingClientRect().bottom ?? 0;
+  // 누른 뒤 생길 아래쪽 알림 자리(72px)를 미리 비워 둔다(부산 현지 미리 보기와 같은 규칙).
+  let bottom = Math.min(window.innerHeight - 72, app.querySelector<HTMLElement>('.flash-toast')?.getBoundingClientRect().top ?? Infinity);
+  if (inPane) { const box = pane!.getBoundingClientRect(); top = Math.max(top, box.top); bottom = Math.min(bottom, box.bottom); }
+  let dy = target.getBoundingClientRect().bottom + 8 - bottom;
+  if (dy < 1) return;
+  if (head) dy = Math.min(dy, head.getBoundingClientRect().top - top - 8);
+  if (dy >= 1) (inPane ? pane! : window).scrollBy(0, dy);
+}
