+/** 오른쪽 칸의 읽기 기준 후보. 다시 그린 뒤에도 같은 열쇠로 찾는다. */
+const SIDE_PANELS = '.crew, .resources, .queue';
+const SIDE_ANCHORS = '.crew h2, .crew h3, .crew h4, .crew article.card, .crew tbody tr, .resources h2, .resources h3, .resources li, .queue h2, .queue li, .queue .growth-notices';
+function sideKey(el: HTMLElement): string {
+  if (el.id) return `#${el.id}`;
+  const panel = el.closest(SIDE_PANELS)?.classList[1] ?? '';
+  return `${panel}|${el.tagName}|${el.dataset.emp ?? (el.textContent ?? '').replace(/\s+/g, ' ').trim().slice(0, 24)}`;
+}
+
+/** 시안 C: 넓은 화면(1001px 이상)의 오른쪽 칸은 따로 굴러가는 창이다. 1000px 이하는 묶음이 풀려 창이 아니다. */
+function paneEl(): HTMLElement | null {
+  const pane = app.querySelector<HTMLElement>('.sidecol');
+  return pane && getComputedStyle(pane).overflowY === 'auto' ? pane : null;
+}
+
+/** 창의 굴림 위치와, 창 안에서 보이던 첫 후보(제목·카드·줄)의 높이를 기억한다. */
+function capturePane() {
+  const pane = paneEl();
+  if (!pane) return null;
+  const box = pane.getBoundingClientRect();
+  const anchors = Array.from(pane.querySelectorAll<HTMLElement>(SIDE_ANCHORS)).map((el) => ({ el, r: el.getBoundingClientRect() }))
+    .filter(({ r }) => r.height > 0 && r.bottom > box.top + 1 && r.top < box.bottom)
+    .map(({ el, r }) => ({ key: sideKey(el), top: r.top }));
+  return { scrollTop: pane.scrollTop, anchors };
+}
+
+/** 다시 그린 창(innerHTML로 새로 생겨 굴림이 0)을 같은 굴림 위치로 되돌리고, 남은 첫 후보를 같은 높이에 둔다. */
+function restorePane(before: ReturnType<typeof capturePane>) {
+  const pane = paneEl();
+  if (!pane || !before) return;
+  pane.scrollTop = before.scrollTop;
+  const all = Array.from(pane.querySelectorAll<HTMLElement>(SIDE_ANCHORS));
+  const hit = before.anchors.map((a) => ({ ...a, element: all.find((el) => sideKey(el) === a.key) })).find((a) => a.element);
+  if (hit) { const dy = hit.element!.getBoundingClientRect().top - hit.top; if (Math.abs(dy) >= 1) pane.scrollTop += dy; }
+}
+
+/** 펼친 칸의 실행 단추(훈련·고용)를 보이는 띠 안으로 최소 거리만 가져온다. 칸 제목(일반 훈련·면담)은 막대(창 위 끝) 아래에 남긴다. */
+function revealBelow(target: HTMLElement | null, head: HTMLElement | null) {
+  if (!target) return;
+  const pane = paneEl();
+  const inPane = !!pane && pane.contains(target);
+  let top = app.querySelector<HTMLElement>('.statusbar')?.getBoundingClientRect().bottom ?? 0;
+  // 누른 뒤 생길 아래쪽 알림 자리(72px)를 미리 비워 둔다(부산 현지 미리 보기와 같은 규칙).
+  let bottom = Math.min(window.innerHeight - 72, app.querySelector<HTMLElement>('.flash-toast')?.getBoundingClientRect().top ?? Infinity);
+  if (inPane) { const box = pane!.getBoundingClientRect(); top = Math.max(top, box.top); bottom = Math.min(bottom, box.bottom); }
+  let dy = target.getBoundingClientRect().bottom + 8 - bottom;
+  if (dy < 1) return;
+  if (head) dy = Math.min(dy, head.getBoundingClientRect().top - top - 8);
+  if (dy >= 1) (inPane ? pane! : window).scrollBy(0, dy);
+}
