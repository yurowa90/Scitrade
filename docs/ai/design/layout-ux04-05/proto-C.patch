+
+/* 시안 C: M2의 넓은 화면(1001px 이상) 오른쪽 칸은 한 묶음이다(오늘 할 일 → 동료 → 자원 예약). 1000px 이하는 묶음을 풀어 한 열 순서를 그대로 쓴다. */
+.sidecol { display: contents; }
+@media (min-width: 1001px) {
+  .layout:has(> .sidecol) { grid-template-rows: auto auto; grid-template-areas: "trade trade side" "world report log"; }
