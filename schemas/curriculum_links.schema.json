{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "curriculum_links v0.4 data shape",
  "description": "Starter data shape, plus semantic checks in tools/validate_data.py. Not a complete game engine command contract.",
  "type": "object",
  "required": [
    "$schema",
    "counts",
    "current_edition_comparison_status",
    "dataset_version",
    "edition",
    "links",
    "notes",
    "schema_version",
    "scope",
    "source_document",
    "source_document_sha256",
    "source_sections",
    "sources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "required": [
        "by_group",
        "by_selection",
        "total"
      ],
      "properties": {
        "by_group": {
          "type": "object",
          "required": [
            "ethics",
            "science",
            "social"
          ],
          "properties": {
            "ethics": {
              "type": "integer"
            },
            "science": {
              "type": "integer"
            },
            "social": {
              "type": "integer"
            }
          },
          "additionalProperties": true
        },
        "by_selection": {
          "type": "object",
          "required": [
            "career",
            "common",
            "general"
          ],
          "properties": {
            "career": {
              "type": "integer"
            },
            "common": {
              "type": "integer"
            },
            "general": {
              "type": "integer"
            }
          },
          "additionalProperties": true
        },
        "total": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "current_edition_comparison_status": {
      "type": "string"
    },
    "dataset_version": {
      "type": "string"
    },
    "edition": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "application_notes",
          "edition",
          "edition_comparison_status",
          "group",
          "id",
          "knowledge_elements",
          "pdf_page",
          "printed_page",
          "priority",
          "selection",
          "source_id",
          "source_url",
          "subject"
        ],
        "properties": {
          "application_notes": {
            "type": "string"
          },
          "edition": {
            "type": "string"
          },
          "edition_comparison_status": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "knowledge_elements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pdf_page": {
            "type": "integer"
          },
          "printed_page": {
            "type": "integer"
          },
          "priority": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "selection": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "achievement_standard_codes_included",
        "convergent_selection_included",
        "element_category",
        "selection_categories"
      ],
      "properties": {
        "achievement_standard_codes_included": {
          "type": "boolean"
        },
        "convergent_selection_included": {
          "type": "boolean"
        },
        "element_category": {
          "type": "string"
        },
        "selection_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "source_document": {
      "type": "string"
    },
    "source_document_sha256": {
      "type": "string"
    },
    "source_sections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "appendix_number",
          "current_edition_comparison_status",
          "edition",
          "id",
          "official_archive_url",
          "official_document_format",
          "official_notice_url",
          "pagination_reference_id_in_design",
          "pdf_page_offset",
          "title",
          "verification_status"
        ],
        "properties": {
          "appendix_number": {
            "type": "integer"
          },
          "current_edition_comparison_status": {
            "type": "string"
          },
          "edition": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "official_archive_url": {
            "type": "string"
          },
          "official_document_format": {
            "type": "string"
          },
          "official_notice_url": {
            "type": "string"
          },
          "pagination_pdf_total_pages": {
            "type": "integer"
          },
          "pagination_reference_id_in_design": {
            "type": "string"
          },
          "pdf_page_offset": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "verification_status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
