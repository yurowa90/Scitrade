          "observations_ko": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "relationship_dedupe_key_template": {
            "type": "string"
          },
          "repeat_policy_ko": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stage": {
            "type": "string"
          },
          "title_ko": {
            "type": "string"
          },
          "venue_id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "schema_version": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
