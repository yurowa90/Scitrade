        "type": "object",
        "required": [
          "actor_experience_dedupe_key_template",
          "city_id",
          "completion_dedupe_key_template",
          "constraints_ko",
          "contact_ids",
          "curriculum_refs",
          "duration_basis",
          "duration_days",
          "effects",
          "eligibility",
          "fictional",
          "id",
          "knowledge_topic",
          "money_cost",
          "observations_ko",
          "relationship_dedupe_key_template",
          "repeat_policy_ko",
          "source_refs",
          "stage",
          "title_ko",
          "venue_id"
        ],
        "properties": {
          "actor_experience_dedupe_key_template": {
            "type": "string"
          },
          "city_id": {
            "type": "string"
          },
          "completion_dedupe_key_template": {
            "type": "string"
          },
          "constraints_ko": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "curriculum_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duration_basis": {
            "type": "string"
          },
          "duration_days": {
            "type": "integer"
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "scope",
                "type"
              ],
              "properties": {
                "contact_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "required_interaction_ko": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                },
                "topic_id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "unlocks": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "eligibility": {
            "type": "object",
            "required": [
              "actor_must_be_available",
              "actor_must_be_in_city",
              "require_sufficient_cash"
            ],
            "properties": {
              "actor_must_be_available": {
                "type": "boolean"
              },
              "actor_must_be_in_city": {
                "type": "boolean"
              },
              "require_sufficient_cash": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          },
          "fictional": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "knowledge_topic": {
            "type": "object",
            "required": [
              "content_revision",
              "id",
              "scope",
              "title_ko"
            ],
            "properties": {
              "content_revision": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              },
              "title_ko": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "money_cost": {
            "type": "object",
            "required": [
              "amount",
              "basis",
              "currency"
            ],
            "properties": {
              "amount": {
                "type": "integer"
              },
              "basis": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              }
            },
