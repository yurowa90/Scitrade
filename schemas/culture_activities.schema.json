{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "culture_activities v0.4 data shape",
  "description": "Starter data shape, plus semantic checks in tools/validate_data.py. Not a complete game engine command contract.",
  "type": "object",
  "required": [
    "$schema",
    "data_basis",
    "items",
    "schema_version"
  ],
