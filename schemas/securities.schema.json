          "company_name_ko": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "drivers_ko": {
            "type": "string"
          },
          "fictional": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "initial_player_holding": {
            "type": "integer"
          },
          "initial_price": {
            "type": "integer"
          },
          "price_model_status": {
            "type": "string"
          },
          "public_information_only": {
            "type": "boolean"
          },
          "sector": {
            "type": "string"
          },
          "security_class": {
            "type": "string"
          },
          "shares_outstanding": {
            "type": "integer"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stage": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "numeric_values_status": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
