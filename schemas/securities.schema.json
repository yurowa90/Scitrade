          "company_name_ko",
          "currency",
          "drivers_ko",
          "fictional",
          "id",
          "initial_player_holding",
          "initial_price",
          "price_model_status",
          "public_information_only",
          "sector",
          "security_class",
          "shares_outstanding",
          "source_refs",
          "stage"
