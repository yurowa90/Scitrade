{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ui_screens v0.4 data shape",
  "description": "Starter data shape, plus semantic checks in tools/validate_data.py. Not a complete game engine command contract.",
  "type": "object",
  "required": [
    "$schema",
    "data_basis",
    "items",
    "schema_version"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "data_basis": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "actions_ko",
          "id",
          "layout_regions",
          "name_ko",
          "opening_advances_time",
          "source_refs",
          "stage",
          "visible_information_ko"
        ],
        "properties": {
          "actions_ko": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "layout_regions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "milestone": {
            "type": "string"
          },
          "name_ko": {
            "type": "string"
          },
          "opening_advances_time": {
            "type": "boolean"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stage": {
            "type": "string"
          },
          "visible_information_ko": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "schema_version": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
