{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "parameters v0.4 data shape",
  "description": "Starter data shape, plus semantic checks in tools/validate_data.py. Not a complete game engine command contract.",
  "type": "object",
  "required": [
    "$schema",
    "data_basis",
    "items",
    "numeric_values_status",
    "schema_version",
    "source_refs"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "data_basis": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "basis",
          "id",
          "notes_ko",
          "unit",
          "value"
        ],
        "properties": {
          "basis": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "json_pointer": {
            "type": "string"
          },
          "notes_ko": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "value": {
            "type": [
              "null",
              "number"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "numeric_values_status": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
