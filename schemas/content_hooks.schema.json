{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "content_hooks v0.4 data shape",
  "description": "Starter data shape, plus semantic checks in tools/validate_data.py. Not a complete game engine command contract.",
  "type": "object",
  "required": [
    "$schema",
    "commands",
    "data_basis",
    "notes_ko",
    "schema_version",
    "source_refs",
    "unlocks"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "arg_names",
          "id",
          "implementation_status",
          "used_by"
        ],
        "properties": {
          "arg_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "id": {
            "type": "string"
          },
          "implementation_status": {
            "type": "string"
          },
          "used_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "data_basis": {
      "type": "string"
    },
    "notes_ko": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unlocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "family",
          "id",
          "implementation_status",
          "source_activity_id"
        ],
        "properties": {
          "family": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "implementation_status": {
            "type": "string"
          },
          "source_activity_id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
